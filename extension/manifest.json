{
  "manifest_version": 3,
  "name": "BidIQ - Upwork AI Proposal Generator",
  "version": "1.1.8",
  "description": "Save connects, check client risk history, and generate tailored AI proposals on Upwork.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.upwork.com/*",
    "http://localhost:3001/*",
    "https://bidiq-o52g.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.upwork.com/jobs/*",
        "https://*.upwork.com/ab/jobs/search/*",
        "https://*.upwork.com/nx/proposals/*",
        "file:///*/mock_upwork_page.html"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*"],
      "matches": [
        "https://*.upwork.com/*",
        "file:///*"
      ]
    }
  ]
}
